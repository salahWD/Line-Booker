<%#
  Whish Money payment panel. The link is shown exactly as the platform admin saved it.
  Opening it does NOT mark anything as paid — the platform admin verifies manually.
%>
<section class="card space-y-5 border-brand-200" aria-labelledby="pay-title">
  <h2 id="pay-title" class="section-title">💳 <%= t('payment.panelTitle') %></h2>

  <dl class="grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl bg-slate-50 p-3">
      <dt class="text-xs text-slate-500"><%= t('payment.branchLabel') %></dt>
      <dd class="font-semibold"><%= panel.businessName %> — <%= panel.branchName %></dd>
    </div>
    <div class="rounded-xl bg-slate-50 p-3">
      <dt class="text-xs text-slate-500"><%= t('common.reference') %></dt>
      <dd class="flex items-center gap-2" x-data="copyText" data-text="<%= panel.reference %>">
        <span class="num text-lg font-bold tracking-wider"><%= panel.reference %></span>
        <button type="button" class="btn btn-ghost btn-sm" @click="copy" x-text="label"><%= t('common.copy') %></button>
      </dd>
    </div>
    <div class="rounded-xl bg-amber-50 p-3 ring-1 ring-amber-200">
      <dt class="text-xs text-amber-800"><%= t('payment.amountLabel') %></dt>
      <dd class="num text-2xl font-bold text-ink"><%= panel.amount %></dd>
    </div>
    <div class="rounded-xl bg-slate-50 p-3">
      <dt class="text-xs text-slate-500"><%= t('payment.typeLabel') %></dt>
      <dd class="font-semibold"><%= panel.feeTypeLabel %></dd>
    </div>
  </dl>

  <div>
    <h3 class="mb-2 font-semibold"><%= t('payment.instructionsTitle') %></h3>
    <ol class="list-inside list-decimal space-y-1 text-sm text-slate-700">
      <li><%= t('payment.step1') %></li>
      <li><%= t('payment.step2', { amount: panel.amount }) %></li>
      <li><%= t('payment.step3', { reference: panel.reference }) %></li>
      <li><%= t('payment.step4') %></li>
    </ol>
    <% if (panel.extraInstructions) { %><p class="mt-2 whitespace-pre-line text-sm text-slate-600"><%= panel.extraInstructions %></p><% } %>
  </div>

  <% if (!panel.url) { %>
    <p class="alert alert-warning"><%= t('payment.notConfigured') %></p>
  <% } else { %>
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-start">
      <div class="flex-1 space-y-2">
        <a href="<%= panel.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg w-full"><%= t('payment.openWhish') %> ↗</a>
        <p class="hint"><%= t('payment.linkNote') %></p>
      </div>
      <figure class="flex flex-col items-center gap-1">
        <div class="size-40 rounded-xl border border-slate-200 bg-white p-2" role="img" aria-label="QR"><%- panel.qrSvg %></div>
        <figcaption class="text-xs text-slate-500"><%= t('payment.scanQr') %></figcaption>
      </figure>
    </div>
  <% } %>

  <form method="post" action="/me/appointments/<%= panel.reference %>/payment" enctype="multipart/form-data" class="space-y-4 border-t border-slate-200 pt-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h3 class="font-semibold"><%= t('payment.iTransferred') %></h3>
    <%- include('field', { name: 'transactionRef', label: t('payment.transactionRef'), required: true, hint: t('payment.transactionRefHint'), attrs: 'dir="ltr" maxlength="80" autocomplete="off"' }) %>
    <div>
      <label class="label" for="proof"><%= t('payment.proof') %> <span class="font-normal text-slate-400">(<%= t('common.optional') %>)</span></label>
      <input id="proof" name="proof" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" class="block w-full text-sm file:me-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-2 file:font-semibold file:text-brand-700">
      <p class="hint"><%= t('payment.proofHint', { mb: maxUploadMb }) %></p>
    </div>
    <button type="submit" class="btn btn-secondary w-full sm:w-auto"><%= t('payment.submit') %></button>
  </form>
</section>
