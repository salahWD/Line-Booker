<%
  // Links per role. Operators and owners share the line console and the appointments pages.
  const links = {
    platform_admin: [
      ['/admin', t('admin.overview')],
      ['/admin/payments', t('admin.payments')],
      ['/admin/businesses', t('admin.businesses')],
      ['/admin/settlement', t('admin.settlement')],
      ['/admin/settings', t('admin.settings')],
      ['/admin/notifications', t('admin.notifications')],
      ['/admin/audit', t('admin.audit')],
    ],
    business_owner: [
      ['/owner', t('owner.overview')],
      ['/operator', t('operator.title')],
      ['/operator/appointments', t('owner.appointments')],
      ['/owner/branches', t('owner.branches')],
      ['/owner/operators', t('owner.operators')],
      ['/owner/reports', t('owner.reports')],
      ['/owner/reviews', t('owner.reviews')],
      ['/owner/audit', t('owner.audit')],
    ],
    branch_operator: [
      ['/operator', t('operator.title')],
      ['/operator/appointments', t('operator.appointmentsTitle')],
    ],
  }[currentUser.role] || [];
  const isActive = (href) => href === currentPath || (href.length > 7 && currentPath.startsWith(href));
%>
<header class="sticky top-0 z-30 border-b border-slate-200 bg-white">
  <div class="container-app flex max-w-7xl items-center justify-between gap-3 py-3">
    <a href="/" class="flex items-center gap-2 font-bold text-brand-700">
      <img src="/images/icon.svg" alt="" class="size-7" width="28" height="28">
      <span><%= appName %></span>
      <% if (currentUser.businessName) { %><span class="hidden text-sm font-medium text-slate-500 sm:inline">· <%= currentUser.businessName %></span><% } %>
    </a>
    <div class="flex items-center gap-2 text-sm">
      <span class="hidden text-slate-600 sm:inline"><%= currentUser.name %></span>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-secondary btn-sm" type="submit"><%= t('nav.logout') %></button>
      </form>
    </div>
  </div>
  <nav class="container-app max-w-7xl" aria-label="<%= t('nav.menu') %>">
    <ul class="-mb-px flex gap-1 overflow-x-auto pb-2">
      <% links.forEach(([href, label]) => { %>
        <li><a href="<%= href %>" class="nav-link <%= isActive(href) ? 'nav-link-active' : '' %>" <%= isActive(href) ? 'aria-current=page' : '' %>><%= label %></a></li>
      <% }) %>
    </ul>
  </nav>
</header>
