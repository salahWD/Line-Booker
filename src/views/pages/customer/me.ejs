<h1 class="page-title mb-6"><%= t('me.hello', { name: currentUser.name }) %></h1>

<section class="mb-8" aria-labelledby="tickets-title">
  <h2 id="tickets-title" class="section-title mb-3"><%= t('me.activeTickets') %></h2>
  <% if (!activeTickets.length) { %>
    <%- include('../../partials/empty', { message: t('me.noTickets'), icon: '🎟️', action: { href: '/', label: t('me.browse') } }) %>
  <% } else { %>
    <ul class="grid gap-3 sm:grid-cols-2">
      <% activeTickets.forEach((tk) => { %>
        <li>
          <a href="/t/<%= tk.trackingToken %>" class="card flex items-center justify-between gap-3 border-brand-200 hover:border-brand-400">
            <div>
              <p class="num text-3xl font-bold text-brand-700"><%= tk.displayCode %></p>
              <p class="muted"><%= tk.lineName %> · <%= tk.branchName %></p>
            </div>
            <%- include('../../partials/badge', { kind: 'ticket', value: tk.status }) %>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="mb-8" aria-labelledby="upcoming-title">
  <h2 id="upcoming-title" class="section-title mb-3"><%= t('appointment.upcoming') %></h2>
  <% if (!upcoming.length) { %>
    <%- include('../../partials/empty', { message: t('appointment.none'), icon: '📅' }) %>
  <% } else { %>
    <ul class="grid gap-3 sm:grid-cols-2">
      <% upcoming.forEach((row) => { const a = row.appointment; %>
        <li>
          <a href="/me/appointments/<%= a.reference %>" class="card flex flex-col gap-2 hover:border-brand-300">
            <div class="flex items-start justify-between gap-2">
              <div>
                <p class="font-bold"><%= row.branchName %></p>
                <p class="muted"><%= row.lineName %></p>
              </div>
              <span class="num text-xs text-slate-500"><%= a.reference %></span>
            </div>
            <p class="font-semibold">📅 <%= fmt.date(a.localDate, row.timezone) %> · <span class="num"><%= fmt.hhmm(a.localTime) %></span></p>
            <div class="flex flex-wrap gap-2">
              <%- include('../../partials/badge', { kind: 'appointment', value: a.status }) %>
              <% if (a.paymentStatus !== 'not_required') { %><%- include('../../partials/badge', { kind: 'payment', value: a.paymentStatus }) %><% } %>
            </div>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<% if (past.length || pastTickets.length) { %>
  <section aria-labelledby="past-title" class="card">
    <h2 id="past-title" class="section-title mb-3"><%= t('appointment.past') %></h2>
    <ul class="divide-y divide-slate-100">
      <% past.forEach((row) => { const a = row.appointment; %>
        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
          <a href="/me/appointments/<%= a.reference %>" class="font-semibold text-brand-700 hover:underline"><%= row.branchName %> — <%= row.lineName %></a>
          <span class="muted num"><%= a.localDate %> <%= fmt.hhmm(a.localTime) %></span>
          <%- include('../../partials/badge', { kind: 'appointment', value: a.status }) %>
        </li>
      <% }) %>
      <% pastTickets.forEach((tk) => { %>
        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
          <a href="/t/<%= tk.trackingToken %>" class="font-semibold hover:underline">🎟️ <span class="num"><%= tk.displayCode %></span> — <%= tk.lineName %></a>
          <span class="muted num"><%= tk.serviceDate %></span>
          <%- include('../../partials/badge', { kind: 'ticket', value: tk.status }) %>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>
