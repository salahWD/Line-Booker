<section class="mb-6 overflow-hidden rounded-3xl bg-gradient-to-l from-brand-700 to-brand-600 px-5 py-8 text-white sm:px-8" data-animate="hero">
  <h1 class="text-2xl font-bold sm:text-3xl"><%= t('app.tagline') %></h1>
  <ul class="mt-4 space-y-2 text-brand-50">
    <li class="flex gap-2"><span aria-hidden="true">🎟️</span><span><%= t('home.howLine') %></span></li>
    <li class="flex gap-2"><span aria-hidden="true">📅</span><span><%= t('home.howAppointment') %></span></li>
  </ul>
</section>

<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
  <h2 class="page-title"><%= t('home.title') %></h2>
  <form method="get" action="/" class="flex w-full gap-2 sm:w-auto" role="search">
    <label for="q" class="sr-only"><%= t('common.search') %></label>
    <input id="q" name="q" value="<%= q %>" class="input sm:w-72" placeholder="<%= t('home.searchPlaceholder') %>">
    <button class="btn btn-secondary" type="submit"><%= t('common.search') %></button>
  </form>
</div>

<% if (!branches.length) { %>
  <%- include('../../partials/empty', { message: t('home.empty'), icon: '🏢' }) %>
<% } else { %>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% branches.forEach((b) => { %>
      <li>
        <a href="/b/<%= b.slug %>" class="card flex h-full flex-col gap-2 transition hover:border-brand-300 hover:shadow-md" data-animate="card">
          <span class="text-xs font-semibold text-brand-700"><%= b.businessName %></span>
          <span class="text-lg font-bold"><%= b.name %></span>
          <span class="muted">📍 <%= b.city %><%= b.address ? ` — ${b.address}` : '' %></span>
          <div class="mt-auto flex flex-wrap gap-2 pt-2">
            <% (linesByBranch[b.id] || []).slice(0, 4).forEach((l) => { %>
              <span class="badge badge-gray"><%= l.name %></span>
            <% }) %>
          </div>
          <span class="badge badge-blue w-fit"><%= t('home.waitingNow', { count: waitingByBranch[b.id] || 0 }) %></span>
        </a>
      </li>
    <% }) %>
  </ul>
<% } %>
