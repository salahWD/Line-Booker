<%
  const free = Number(branch.feeAmount) <= 0;
%>
<div class="mb-6">
  <p class="text-sm font-semibold text-brand-700"><%= businessName %></p>
  <h1 class="page-title"><%= branch.name %></h1>
  <p class="muted mt-1">📍 <%= branch.city %><%= branch.address ? ` — ${branch.address}` : '' %><% if (branch.phone) { %> · ☎ <span class="num"><%= branch.phone %></span><% } %></p>
  <% if (rating) { %><p class="mt-1 text-sm">⭐ <span class="num"><%= rating.avg %></span> <span class="muted">(<%= rating.count %>)</span></p><% } %>
</div>

<%# Live line cards: counts refresh through SSE + fetch (component "branchLive"). %>
<section aria-labelledby="lines-title" class="mb-8" x-data="branchLive" data-state-url="/b/<%= branch.slug %>/state" data-events-url="/b/<%= branch.slug %>/events" data-initial="<%= JSON.stringify(lines.map((l) => l.summary)) %>">
  <h2 id="lines-title" class="section-title mb-3"><%= t('branch.lines') %></h2>
  <%- include('../../partials/connection-banner') %>
  <% if (!lines.length) { %>
    <%- include('../../partials/empty', { message: t('home.empty'), icon: '🕒' }) %>
  <% } %>
  <ul class="grid gap-4 md:grid-cols-2">
    <% lines.forEach((line) => { const s = line.summary; %>
      <li class="card flex flex-col gap-3" data-line-id="<%= line.id %>">
        <div class="flex items-start justify-between gap-2">
          <div>
            <h3 class="text-lg font-bold"><%= line.name %></h3>
            <% if (line.description) { %><p class="muted"><%= line.description %></p><% } %>
          </div>
          <span class="badge badge-red" x-show="lineState(<%= line.id %>).closed" <%= s.isOpen ? 'x-cloak' : '' %>><%= t('branch.closed') %></span>
          <span class="badge badge-amber" x-show="lineState(<%= line.id %>).paused" <%= s.paused ? '' : 'x-cloak' %>><%= t('branch.paused') %></span>
        </div>
        <dl class="grid grid-cols-3 gap-2 text-center">
          <div class="rounded-xl bg-slate-50 p-2">
            <dt class="text-xs text-slate-500"><%= t('branch.waiting') %></dt>
            <dd class="num text-xl font-bold" x-text="lineState(<%= line.id %>).waiting"><%= s.waiting %></dd>
          </div>
          <div class="rounded-xl bg-slate-50 p-2">
            <dt class="text-xs text-slate-500"><%= t('branch.estimate') %></dt>
            <dd class="text-sm font-bold"><span class="num" x-text="lineState(<%= line.id %>).range"><%= s.estimate.lowMin %>–<%= s.estimate.highMin %></span> <%= t('common.minutesShort') %></dd>
          </div>
          <div class="rounded-xl bg-slate-50 p-2">
            <dt class="text-xs text-slate-500"><%= t('ticket.pace') %></dt>
            <dd class="text-sm font-bold"><span class="num" x-text="lineState(<%= line.id %>).pace"><%= s.estimate.paceMinutes %></span> <%= t('common.minutesShort') %></dd>
          </div>
        </dl>
        <details class="text-sm text-slate-600">
          <summary class="cursor-pointer font-semibold"><%= t('branch.queuePolicy') %></summary>
          <p class="mt-1"><%= line.policyText %></p>
        </details>
        <div class="mt-auto flex flex-wrap gap-2">
          <% if (line.allowRemoteJoin) { %>
            <form method="post" action="/lines/<%= line.id %>/join" class="flex-1">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-primary w-full" <%= s.isOpen ? '' : 'disabled' %>>🎟️ <%= t('branch.takeNumber') %></button>
            </form>
          <% } else { %>
            <p class="badge badge-gray flex-1 justify-center py-2"><%= t('branch.remoteJoinOff') %></p>
          <% } %>
          <a href="/book/<%= branch.slug %>/<%= line.id %>" class="btn btn-secondary flex-1">📅 <%= t('branch.bookAppointment') %></a>
        </div>
      </li>
    <% }) %>
  </ul>
</section>

<div class="grid gap-6 md:grid-cols-2">
  <section class="card" aria-labelledby="hours-title">
    <h2 id="hours-title" class="section-title mb-3"><%= t('branch.hours') %></h2>
    <% if (!hours.length) { %>
      <p class="muted"><%= t('branch.noHours') %></p>
    <% } else { %>
      <dl class="space-y-1 text-sm">
        <% [1, 2, 3, 4, 5, 6, 7].forEach((d) => { const rows = hours.filter((h) => h.weekday === d); %>
          <div class="flex justify-between gap-3 border-b border-slate-100 py-1">
            <dt class="font-semibold"><%= t(`weekdays.${d}`) %></dt>
            <dd class="num text-slate-600"><%= rows.length ? rows.map((h) => `${fmt.hhmm(h.openTime)}–${fmt.hhmm(h.closeTime)}`).join('، ') : '—' %></dd>
          </div>
        <% }) %>
      </dl>
    <% } %>
    <div class="mt-4 rounded-xl bg-slate-50 p-3 text-sm">
      <p class="font-semibold"><%= t('branch.fee') %>: <span class="num"><%= free ? t('branch.free') : fmt.money(branch.feeAmount, branch.currency) %></span>
        <% if (!free) { %><span class="muted">(<%= t(`payment.feeTypes.${branch.feeType}`) %>)</span><% } %></p>
      <% if (branch.cancellationPolicyText) { %>
        <p class="mt-2"><span class="font-semibold"><%= t('branch.cancellationPolicy') %>:</span> <%= branch.cancellationPolicyText %></p>
      <% } %>
    </div>
  </section>

  <section class="card" aria-labelledby="reviews-title">
    <h2 id="reviews-title" class="section-title mb-3"><%= t('branch.reviews') %></h2>
    <% if (!reviews.length) { %>
      <p class="muted"><%= t('branch.noReviews') %></p>
    <% } else { %>
      <ul class="space-y-4">
        <% reviews.forEach(({ review, customerName, lineName }) => { %>
          <li class="border-b border-slate-100 pb-3">
            <p class="text-amber-500" aria-label="<%= t('reviews.stars', { n: review.rating }) %>"><%= '★'.repeat(review.rating) %><span class="text-slate-300"><%= '★'.repeat(5 - review.rating) %></span></p>
            <% if (review.comment) { %><p class="mt-1"><%= review.comment %></p><% } %>
            <p class="muted mt-1"><%= customerName ? customerName.split(' ')[0] : '' %> · <%= lineName %></p>
            <% if (review.ownerReply) { %>
              <div class="mt-2 rounded-lg bg-brand-50 p-2 text-sm"><span class="font-semibold"><%= t('branch.ownerReply') %>:</span> <%= review.ownerReply %></div>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
