# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=دوري
# Public base URL (used in SMS links and push notification links)
APP_URL=http://localhost:3000
# Set to 1 when running behind a reverse proxy (needed for secure cookies + correct client IPs)
TRUST_PROXY=0

# ─── Database ──────────────────────────────────────────
# Development: `npm run db:start` runs an embedded PostgreSQL on EMBEDDED_PG_PORT.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/booking
EMBEDDED_PG_PORT=5433
EMBEDDED_PG_PASSWORD=postgres

# ─── Secrets (use long random strings in production) ───
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_SECRET=change-me-to-another-long-random-string-32-chars

# ─── Background jobs ───────────────────────────────────
# true = the web process also runs pg-boss workers. Set false and run `npm run worker` to split them.
RUN_JOBS=true
# Hours before an appointment to send the reminder
REMINDER_HOURS_BEFORE=3

# ─── Time & region ─────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Beirut
DEFAULT_PHONE_COUNTRY=LB

# ─── OTP ───────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# ─── SMS ───────────────────────────────────────────────
# mock   = development mock: nothing is sent, messages are printed to the console and shown on /dev/notifications
# twilio = Twilio REST API (needs the three TWILIO_* values)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Shared secret appended to the delivery-status webhook URL (?secret=...)
SMS_WEBHOOK_SECRET=change-me

# ─── Push notifications (Firebase Cloud Messaging) ─────
# Leave FIREBASE_PROJECT_ID empty to use the development push mock.
# Server credentials (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key on one line with \n for newlines
FIREBASE_PRIVATE_KEY=
# Web app config (Project settings → General → Your apps → Web app) — these are public values
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
# Project settings → Cloud Messaging → Web Push certificates → Key pair
FIREBASE_WEB_VAPID_KEY=
# Firebase JS SDK version loaded from gstatic in the browser
FIREBASE_WEB_SDK_VERSION=10.14.1

# ─── Uploads ───────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
