{
  "name": "dawri-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Arabic-first take-a-number lines and paid appointments (Express + EJS + MySQL/MariaDB)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node database/seeds/seed.js",
    "db:reset": "node scripts/reset.js && node scripts/migrate.js && node database/seeds/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "css:build": "tailwindcss -i src/public/css/input.css -o src/public/css/app.css --minify",
    "css:watch": "tailwindcss -i src/public/css/input.css -o src/public/css/app.css --watch",
    "build": "npm run css:build",
    "dev": "concurrently -k -n css,web -c blue,green \"npm:css:watch\" \"node --watch src/server.js\"",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "check": "node scripts/check-critical-flows.js"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.17.5",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "file-type": "^21.3.4",
    "firebase-admin": "^13.10.0",
    "gsap": "^3.15.1",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.17",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11"
  }
}
